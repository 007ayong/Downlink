{
  "name": "downlink",
  "private": true,
  "version": "1.3.8",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node --test",
    "dev": "node scripts/package-extension.mjs all --watch --no-zip",
    "dev:firefox": "node scripts/package-extension.mjs firefox --watch --no-zip",
    "dev:chromium": "node scripts/package-extension.mjs chromium --watch --no-zip",
    "package:release": "node scripts/package-extension.mjs all",
    "package:all": "node scripts/package-extension.mjs all",
    "package:chromium": "node scripts/package-extension.mjs chromium",
    "package:firefox": "node scripts/package-extension.mjs firefox",
    "safari:sync": "node scripts/sync-safari-resources.mjs",
    "safari:build": "node scripts/sync-safari-resources.mjs && xcodebuild -project safari/Downlink/Downlink.xcodeproj -scheme Downlink -configuration Release -destination 'generic/platform=macOS' -derivedDataPath dist/safari/DerivedData -allowProvisioningUpdates LM_FILTER_WARNINGS=YES build"
  }
}
